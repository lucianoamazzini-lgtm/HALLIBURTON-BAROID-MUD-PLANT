<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Halliburton Baroid - Mud Plant</title>

<style>
  body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f2f2f2;
    margin: 0;
    padding: 0;
  }

  .header {
    text-align: center;
    padding: 20px 10px;
    background-color: white;
    border-bottom: 4px solid #d10000;
  }

  .halliburton {
    color: #d10000;
    font-size: 34px;
    font-weight: 900;
    margin: 0;
    letter-spacing: 2px;
  }

  .subtitle {
    color: #222;
    font-size: 18px;
    margin-top: 6px;
    font-weight: 600;
  }

  .container {
    padding: 20px;
  }

  .box {
    background: white;
    padding: 15px;
    border-radius: 10px;
    margin-bottom: 20px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  }

  h3 {
    margin-top: 0;
    color: #d10000;
  }

  label {
    font-weight: bold;
  }

  input {
    width: 100%;
    padding: 10px;
    margin: 8px 0;
    font-size: 16px;
  }

  button {
    width: 100%;
    padding: 12px;
    background-color: #ffcc00;
    border: none;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
  }

  button:hover {
    background-color: #e6b800;
  }

  .result {
    margin-top: 10px;
    font-weight: bold;
    font-size: 16px;
  }
</style>
</head>

<body>

<div class="header">
  <h1 class="halliburton">HALLIBURTON BAROID</h1>
  <h2 class="subtitle">Mud Plant – Calculador de Barita</h2>
</div>

<div class="container">

  <!-- CALCULADORA BARITA -->
  <div class="box">
    <h3>🧪 Cálculo de Barita</h3>

    <label>Densidad inicial (ppg)</label>
    <input type="number" id="densIni">

    <label>Densidad final (ppg)</label>
    <input type="number" id="densFin">

    <label>Volumen inicial (bbl)</label>
    <input type="number" id="volIni">

    <button onclick="calcularBarita()">Calcular Barita</button>

    <div class="result" id="resBarita"></div>
  </div>

  <!-- CONVERSIÓN m3 A bbl -->
  <div class="box">
    <h3>📐 Conversión m³ → bbl</h3>

    <label>Volumen (m³)</label>
    <input type="number" id="m3">

    <button onclick="convertir()">Convertir</button>

    <div class="result" id="resConv"></div>
  </div>

</div>

<script>
  function calcularBarita() {
    let Di = parseFloat(document.getElementById("densIni").value);
    let Df = parseFloat(document.getElementById("densFin").value);
    let V = parseFloat(document.getElementById("volIni").value);

    if (Df <= Di) {
      document.getElementById("resBarita").innerText =
        "La densidad final debe ser mayor a la inicial";
      return;
    }

    let barita = (1470 * (Df - Di) * V) / (35 - Df);

    document.getElementById("resBarita").innerText =
      "Barita necesaria ≈ " + barita.toFixed(2) + " lb";
  }

  function convertir() {
    let m3 = parseFloat(document.getElementById("m3").value);
    let bbl = m3 * 6.2898;

    document.getElementById("resConv").innerText =
      m3 + " m³ = " + bbl.toFixed(2) + " bbl";
  }
</script>

</body>
</html>
